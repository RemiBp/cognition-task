// Prototype uses SQLite so the repo runs with zero infrastructure.
// Swapping to Postgres is a provider change plus a migration; nothing in
// platform/ depends on the engine.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id    String @id @default(cuid())
  email String @unique
  name  String
  role  String // viewer | analyst | approver | admin

  auditLogs         AuditLog[]
  requestedApproval ApprovalRequest[] @relation("requestedBy")
  decidedApproval   ApprovalRequest[] @relation("decidedBy")
}

/// Append-only. Written by platform/actions.ts on every mutation, so an app
/// author cannot forget it.
model AuditLog {
  id         String   @id @default(cuid())
  at         DateTime @default(now())
  actorId    String
  actorEmail String
  actorRole  String
  action     String // e.g. refund.approve
  resource   String // e.g. refund
  resourceId String?
  outcome    String // executed | proposed | denied | approved | rejected
  before     String? // JSON snapshot
  after      String? // JSON snapshot
  reason     String?
  requestId  String

  actor User @relation(fields: [actorId], references: [id])

  @@index([resource, resourceId])
  @@index([at])
}

/// Maker-checker. A sensitive action becomes a proposal that a different user
/// with a decision role has to approve before it is applied.
model ApprovalRequest {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  action        String
  resource      String
  /// Always the action's canonical id: the reservation index below must never
  /// depend on NULL comparison semantics to hold.
  resourceId    String
  payload       String // JSON args for the registered action handler
  payloadHash   String // canonical hash of the payload, for retry equivalence
  requestKey    String @unique // actor + action + resource + payload hash
  targetVersion Int // resource version the proposal was made against
  summary       String
  subject       String? // customer-facing identity, e.g. KYC-DEMO-001 · Mateo Moreau
  reason        String?
  status        String   @default("pending") // pending | approved | rejected
  /// "active" while pending, replaced by the request id once decided. The
  /// unique index below is therefore a database-side reservation: one active
  /// proposal per resource, enforced by the engine rather than by a read.
  activeKey     String   @default("active")
  requestedById String
  decidedById   String?
  decidedAt     DateTime?
  decisionNote  String?

  requestedBy User  @relation("requestedBy", fields: [requestedById], references: [id])
  decidedBy   User? @relation("decidedBy", fields: [decidedById], references: [id])

  @@unique([resource, resourceId, activeKey])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Below: the three apps that exist in Power Apps today. Thin domain models —
// all of the governance lives in the platform tables above.
// ---------------------------------------------------------------------------

model KycCase {
  id              String   @id @default(cuid())
  reference       String   @unique // human reference used in approvals and history
  customerName    String
  country         String
  riskScore       Int
  documentType    String
  status          String   @default("pending") // pending | approved | rejected | escalated
  submittedAt     DateTime @default(now())
  notes           String?
  /// Synthetic summary of what a reviewer would have looked at. The prototype
  /// stores no identity documents and performs no verification.
  evidenceSummary String?
  /// Reasoning recorded by the analyst or approver on the latest decision.
  reasoning       String?
  isDemo          Boolean  @default(false)
  version         Int      @default(0)
  updatedAt       DateTime @updatedAt
}

model Refund {
  id            String   @id @default(cuid())
  orderId       String
  customerName  String
  amountCents   Int
  currency      String   @default("EUR")
  reason        String
  status        String   @default("pending") // pending | approved | rejected
  requestedAt   DateTime @default(now())
  processorRef  String?
  reasoning     String?
  version       Int      @default(0)
}

model FeatureFlag {
  id             String   @id @default(cuid())
  key            String   @unique
  description    String
  enabled        Boolean  @default(false)
  rolloutPercent Int      @default(0)
  environment    String   @default("production")
  updatedAt      DateTime @updatedAt
  version        Int      @default(0)
}

model Dispute {
  id           String   @id @default(cuid())
  reference    String   @unique
  customerName String
  amountCents  Int
  currency     String   @default("EUR")
  reason       String
  status       String   @default("open") // open | refunded | closed
  processorRef String?
  openedAt     DateTime @default(now())
  reasoning    String?
  version      Int      @default(0)
}
